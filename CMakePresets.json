{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "ON",
                "SPSC_BUILD_TESTING": "ON",
                "SPSC_SANITIZER": "none"
            }
        },
        {
            "name": "default",
            "displayName": "default",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "asan",
            "displayName": "Default + ASan",
            "inherits": "default",
            "cacheVariables": {
                "SPSC_SANITIZER": "address"
            }
        },
        {
            "name": "ubsan",
            "displayName": "Default + UBSan",
            "inherits": "default",
            "cacheVariables": {
                "SPSC_SANITIZER": "undefined"
            }
        },
        {
            "name": "tsan",
            "displayName": "Default + TSan",
            "inherits": "default",
            "cacheVariables": {
                "SPSC_SANITIZER": "thread"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": 0
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "jobs": 0
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "jobs": 0
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan",
            "jobs": 0
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "jobs": 0
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "default",
            "displayName": "Workflow (Default)",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "default"
                },
                {
                    "type": "test",
                    "name": "default"
                }
            ]
        },
        {
            "name": "debug",
            "displayName": "Workflow (Debug)",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                },
                {
                    "type": "test",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "asan",
            "displayName": "Workflow (ASan)",
            "steps": [
                {
                    "type": "configure",
                    "name": "asan"
                },
                {
                    "type": "build",
                    "name": "asan"
                },
                {
                    "type": "test",
                    "name": "asan"
                }
            ]
        },
        {
            "name": "ubsan",
            "displayName": "Workflow (UBSan)",
            "steps": [
                {
                    "type": "configure",
                    "name": "ubsan"
                },
                {
                    "type": "build",
                    "name": "ubsan"
                },
                {
                    "type": "test",
                    "name": "ubsan"
                }
            ]
        },
        {
            "name": "tsan",
            "displayName": "Workflow (TSan)",
            "steps": [
                {
                    "type": "configure",
                    "name": "tsan"
                },
                {
                    "type": "build",
                    "name": "tsan"
                },
                {
                    "type": "test",
                    "name": "tsan"
                }
            ]
        }
    ]
}
